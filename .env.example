# Is file ko copy karke .env naam se banayein aur values bharein.
# Netlify par: Site settings -> Environment variables mein yahi daalein.

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary (unsigned upload preset ka naam)
